{
  "name": "@swalay/poly-react",
  "version": "0.2.1",
  "description": "React bindings for poly: provider, hook and a ready-made prompt that offers to switch the interface to the language people speak.",
  "keywords": [
    "react",
    "i18n",
    "translation",
    "voice",
    "speech",
    "language-detection",
    "kiosk",
    "self-service",
    "accessibility",
    "react-i18next"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorAGuerra/Poly-SLID-Interface-Translator.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/VictorAGuerra/Poly-SLID-Interface-Translator#readme",
  "bugs": "https://github.com/VictorAGuerra/Poly-SLID-Interface-Translator/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@swalay/poly-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
