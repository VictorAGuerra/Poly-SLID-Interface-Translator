{
  "name": "@swalay/poly-core",
  "version": "0.2.0",
  "description": "Voice-driven interface translation: detects the spoken language and translates your UI texts on the fly, with protected terms, reviewed overrides and caching.",
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "voice",
    "speech",
    "language-detection",
    "whisper",
    "kiosk",
    "self-service",
    "accessibility",
    "i18next"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VictorAGuerra/Poly-SLID-Interface-Translator.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/VictorAGuerra/Poly-SLID-Interface-Translator#readme",
  "bugs": "https://github.com/VictorAGuerra/Poly-SLID-Interface-Translator/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "i18next": ">=23"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "i18next": "^26.5.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
